# =============================================================================
# .dockerignore — Archivos que NO se incluyen en la imagen de OpenClaw
# =============================================================================

# Archivos de control de versión
.git
.gitignore
.gitattributes
.github/

# Archivos de entorno (contienen secretos)
.env
.env.production
.env.development
.env.local

# Archivos de node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Archivos de compilación
dist/
build/
*.tsbuildinfo

# Archivos de sistema
.DS_Store
Thumbs.db
.envrc
.dir-locals.el

# Archivos de OpenClaw (se generan en runtime)
.openclaw/
*.session

# Logs
logs/
*.log

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp

# Configuración local de desarrollo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Documentación (no necesaria en contenedor)
*.md
!README.md

# Tests
*.test.*
*.spec.*
__tests__/
tests/

# Cobertura
coverage/
.nyc_output/
