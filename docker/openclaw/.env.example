# =============================================================================
# .env.example — Variables de entorno para OpenClaw en Railway Hobby
# =============================================================================
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas este archivo con valores reales al repositorio.
# =============================================================================

# =============================================================================
# 1. SECRETOS (obtén estos valores por canales seguros, NO los pegues en el chat)
# =============================================================================

# Secreto del Agent MCP de SportBot (se genera en Supabase)
AGENT_MCP_SECRET=tu-secreto-aqui

# Token del bot de Telegram de Vera (crea el bot en @BotFather)
TELEGRAM_VERA_BOT_TOKEN=tu-token-de-bot-aqui

# Identificador personal del owner de Telegram: configura localmente y no lo versionas
TELEGRAM_OWNER_ID=YOUR_TELEGRAM_OWNER_ID

# Clave de OpenAI (para razonamiento del agente y TTS)
OPENAI_API_KEY=tu-clave-de-openai-aqui

# =============================================================================
# 2. CONFIGURACIÓN DE RAILWAY (generalmente no cambia)
# =============================================================================

# Puerto del Gateway de OpenClaw
OPENCLAW_GATEWAY_PORT=18789

# Host del Gateway
OPENCLAW_GATEWAY_HOST=0.0.0.0

# Modo de operación
OPENCLAW_MODE=agent

# ID del agente Vera
OPENCLAW_AGENT_ID=vera

# Directorio de trabajo de Vera
OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace-vera

# Endpoint del MCP de SportBot (no cambiar)
OPENCLAW_MCP_SERVER_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co/functions/v1/agent_mcp

# Proveedor de TTS
OPENCLAW_TTS_PROVIDER=openai

# Modelo de TTS
OPENCLAW_TTS_MODEL=gpt-4o-mini-tts

# Voz de TTS (coral es femenina tipo Cortana/F.R.I.D.A.Y.)
OPENCLAW_TTS_VOICE=coral

# Modo de TTS: "inbound" = solo responde con voz cuando el usuario envía voz
OPENCLAW_TTS_AUTO=inbound

# Nivel de logging
OPENCLAW_LOG_LEVEL=info

# =============================================================================
# 3. NOTAS IMPORTANTES
# =============================================================================
# - Este archivo es solo un ejemplo. NO lo subas al repositorio con valores reales.
# - Crea tu archivo .env copiando este: cp .env.example .env
# - Luego edita .env con tus valores reales.
# - En Railway, configura estas variables en la sección de Environment Variables
#   del proyecto, no las subas al código.
