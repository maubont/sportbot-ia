{
  "name": "sportbot-ia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @sportbot/frontend --filter @sportbot/admin dev",
    "dev:frontend": "corepack pnpm --filter @sportbot/frontend dev",
    "dev:admin": "corepack pnpm --filter @sportbot/admin dev",
    "build": "corepack pnpm -r --if-present build",
    "build:frontend": "corepack pnpm --filter @sportbot/frontend build",
    "build:admin": "corepack pnpm --filter @sportbot/admin build",
    "lint": "corepack pnpm -r --if-present lint",
    "lint:frontend": "corepack pnpm --filter @sportbot/frontend lint",
    "lint:admin": "corepack pnpm --filter @sportbot/admin lint",
    "test:admin": "node --experimental-strip-types --test admin/src/lib/inboxContext.test.mjs admin/src/lib/catalog.test.mjs admin/src/lib/logistics.test.mjs admin/src/lib/agentActionPresentation.test.mjs",
    "test:frontend": "node --experimental-strip-types --test frontend/src/lib/colors.test.mjs frontend/src/lib/catalog.test.mjs",
    "test:supabase": "node --experimental-strip-types --test supabase/functions/_shared/admin_auth_roles.test.mjs supabase/functions/telegram_admin_webhook/logic.test.mjs supabase/functions/storefront_events/logic.test.mjs supabase/functions/twilio_inbound_whatsapp/handoff.test.mjs supabase/functions/twilio_inbound_whatsapp/signature.test.mjs supabase/functions/agent_mcp/agent-mcp-core.test.mjs",
    "test:stage-a": "node --experimental-strip-types --test supabase/functions/twilio_inbound_whatsapp/state.test.mjs supabase/functions/twilio_inbound_whatsapp/idempotency.test.mjs supabase/functions/twilio_inbound_whatsapp/inbound-claim.test.mjs supabase/functions/twilio_inbound_whatsapp/tools.test.mjs supabase/functions/twilio_inbound_whatsapp/payments.test.mjs supabase/functions/twilio_inbound_whatsapp/vision.test.mjs supabase/functions/twilio_inbound_whatsapp/receipt-capture.test.mjs supabase/functions/admin_conversation_actions/operator-messaging.test.mjs",
    "test:stage-b": "node --experimental-strip-types --test supabase/functions/_shared/channels/channels.test.mjs supabase/functions/_shared/channels/test-guard.test.mjs supabase/functions/_shared/logistics_notifications.test.mjs supabase/functions/_shared/tracking_url.test.mjs",
    "verify:stage-a-sql": "node scripts/verify-stage-a-sql.mjs",
    "verify:stage-b-sql": "node scripts/verify-stage-b-sql.mjs",
    "verify:e3-sql": "node scripts/verify-e3-sql.mjs",
    "verify:e3-shortfall-sql": "node scripts/verify-e3-shortfall-sql.mjs",
    "verify:p2-payment-fee-sql": "node scripts/verify-p2-payment-fee-sql.mjs",
    "verify:security-grants-sql": "node scripts/verify-security-grants-sql.mjs",
    "verify:rpc-actor-hardening-sql": "node scripts/verify-rpc-actor-hardening-sql.mjs",
    "verify:admin-role-hardening-sql": "node scripts/verify-admin-role-hardening-sql.mjs",
    "verify:operator-order-column-hardening-sql": "node scripts/verify-operator-order-column-hardening-sql.mjs",
    "verify:agent-mcp-sql": "node scripts/verify-agent-mcp-sql.mjs",
    "verify:conversation-reads-sql": "node scripts/verify-conversation-reads-sql.mjs",
    "verify:quick-answers-sql": "node scripts/verify-quick-answers-sql.mjs",
    "verify:conversation-closures-sql": "node scripts/verify-conversation-closures-sql.mjs",
    "verify:search-conversations-sql": "node scripts/verify-search-conversations-sql.mjs",
    "verify:inbox-notifications-activity-sql": "node scripts/verify-inbox-notifications-activity-sql.mjs",
    "verify:e4-sql": "node scripts/verify-e4-sql.mjs",
    "verify:human-messaging-sql": "node scripts/verify-human-messaging-sql.mjs",
    "verify:logistics-retry-sql": "node scripts/verify-logistics-retry-sql.mjs",
    "verify:colors-sql": "node scripts/verify-colors-sql.mjs",
    "verify:catalog-operable-sql": "node scripts/verify-catalog-operable-sql.mjs",
    "verify:order-ficha-sql": "node scripts/verify-order-ficha-sql.mjs",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "typecheck:frontend": "corepack pnpm --filter @sportbot/frontend typecheck",
    "typecheck:admin": "corepack pnpm --filter @sportbot/admin typecheck"
  },
  "workspaces": [
    "frontend",
    "admin",
    "packages/*"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
